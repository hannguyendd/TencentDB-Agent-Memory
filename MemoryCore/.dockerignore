# -- Sensitive config (not baked into the image; in production use env injection or volume mounts) --
# Root-level yaml files such as tdai-gateway.yaml may retain real values for Langfuse / VDB / API_KEY etc.,
# They should not ship in the image even with empty-string fallback; prod uses K8s Secret + env template.
tdai-gateway.yaml
tdai-gateway.*.yaml
.env
.env.*
**/.env
**/.env.*

# Internal CI/git metadata
.gitmodules
.coding-ci.yaml
.gitlab-ci.yml

# src/integrations is the mount point of a private submodule. On the open-source branch this directory does not exist (git
# treats it as an empty submodule pointer); after an internal build checks it out, it carries the Redis /
# COS / Shark / Observability backend implementations. Previously dockerignore blocked the whole directory here,
# so internal deployments with state_backend=redis failed at startup because index.js could not be found
# ("Cannot find module '/app/src/integrations/redis/index.js'").
# Now allowed: open-source builds copying an empty directory is harmless, and internal builds can actually load the backends.

# e2e / load-test / smoke scripts are not needed at runtime and contain debug-purpose SSH host / intranet IP references
scripts/e2e-*
scripts/verify-*
scripts/warm-*
scripts/stress-*
scripts/inspect-*
scripts/smoke-*
scripts/start-offload-*
scripts/check_sts_*
scripts/mock-shark-*
scripts/bench-*
scripts/soak-*

# Keep necessary md files (excluded by *.md above, but README.md etc. have no effect on running, so there is no need to keep them)
# If you need to read README.md inside the container, delete the *.md line above
