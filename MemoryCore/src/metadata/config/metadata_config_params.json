{
  "version": "1",
  "modules": [
    {
      "module": "quota",
      "description": "Instance-level quota parameters",
      "params": [
        {
          "param_name": "max_users_per_instance",
          "param_value": "500",
          "description": "Maximum number of users per instance",
          "allowed_scopes": ["global"]
        },
        {
          "param_name": "max_teams_per_instance",
          "param_value": "100",
          "description": "Maximum number of teams per instance",
          "allowed_scopes": ["global"]
        }
      ]
    },
    {
      "module": "asset_type",
      "description": "AssetType resource usage switches",
      "params": [
        {
          "param_name": "skill.enabled",
          "param_value": "1",
          "description": "Whether Skill assets may be used",
          "allowed_scopes": ["global", "user"]
        },
        {
          "param_name": "llm_wiki.enabled",
          "param_value": "1",
          "description": "Whether LLM Wiki assets may be used",
          "allowed_scopes": ["global", "user"]
        },
        {
          "param_name": "code_graph.enabled",
          "param_value": "1",
          "description": "Whether Code Graph assets may be used",
          "allowed_scopes": ["global", "user"]
        },
        {
          "param_name": "chat_memory.enabled",
          "param_value": "1",
          "description": "Whether Chat Memory assets may be used",
          "allowed_scopes": ["global", "user"]
        }
      ]
    }
  ]
}
