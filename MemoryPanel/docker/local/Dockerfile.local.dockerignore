# Ignore list dedicated to Dockerfile.local (BuildKit: <dockerfile>.dockerignore takes precedence over the root .dockerignore)
# Purpose: shrink the build context and avoid copying host artifacts into the image
#   — especially node_modules (the better-sqlite3 native binary is compiled for the host platform and would crash inside the image;
#      it is re-installed and recompiled with npm install inside the image), and data/ (containing real user SQLite data).

# Dependencies (re-installed inside the image)
**/node_modules
.pnpm-store/

# Build artifacts (re-built inside the image)
**/dist
**/build
**/*.js.map
**/*.tsbuildinfo
frontend/src/**/*.js
frontend/src/**/*.js.map

# Environment and local data (must not go into the image)
# ⚠️ config/*.json contains the real kernel api_key (bearer token); it must be injected via a runtime mount or
#    K8s Secret, and must never be baked into the image. Runtime mapping example:
#      -v /path/to/metadata-instances.json:/app/config/metadata-instances.json:ro
.env
.env.*
config/*.json
config/*.yaml
config/*.yml
data/
**/*.db
**/*.db-shm
**/*.db-wal
**/*.sqlite

# Logs / coverage / e2e output
**/logs
**/*.log
coverage/
frontend/test-results/
frontend/playwright-report/

# Version control and tool metadata
.git
.gitignore
.idea/
.vscode/
.iwiki
.codebuddy

# OS / editor miscellany
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Temporary directories
tmp/
.tmp/

# Docs do not take part in runtime (optional, to slim the context further)
docs/

# Test scripts do not take part in runtime (the shell hardcodes the internal path `/root/git.woa.com/cloud_nosql/tdai`,
# baking them into the image would leak the internal GitLab domain and deployment habits)
tests/
**/*.e2e.sh
e2e-*.sh
