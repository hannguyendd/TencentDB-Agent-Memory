# Dependencies
node_modules/
.pnpm-store/

# Build
dist/
build/
*.js.map

# Environment
.env
.env.*
!.env.example

# Instance registry: contains the tdai kernel bearer token, must not be committed.
# Each dev machine builds its own real-value file locally from config/metadata-instances.example.json.
# Real values were committed in history, a legacy issue (history cleanup can wait when the repo is not distributed externally);
# if the repo is ever open-sourced / shown to customers, history must be cleaned with git filter-repo.
config/metadata-instances.json
!config/metadata-instances.example.json

# Local data (SQLite runtime DB, contains real user identity data, must not be committed)
data/
*.db
*.db-shm
*.db-wal
*.sqlite

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.codebuddy

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Test coverage
coverage/

# Temporary
tmp/
.tmp/

# iWiki plugin files
.iwiki

# tsc incremental build info
*.tsbuildinfo

# vite / tsc build output: frontend/src sources may only be .ts/.tsx; build output is not committed
frontend/src/**/*.js
frontend/src/**/*.js.map

# Playwright e2e test output
frontend/test-results/
frontend/playwright-report/

specs/
.cursor/

# Instance registry with secrets (use metadata-instances.example.json)
config/metadata-instances.json

# Internal / company-only docs (keep local copies; do not publish)
docs/internal/

# Generated E2E reports
docs/test-reports/

# Smoke credentials (generated locally)
scripts/smoke/

# Internal architecture docs (keep local copies; do not publish)
docs/architecture/*.md

# Draft contributing guides live outside default commits until open-source PR
CONTRIBUTING.md
CONTRIBUTING_CN.md
